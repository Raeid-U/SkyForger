              },
              "fieldAudit": {
                "type": "object",
                "properties": {
                  "ingredients": {
                    "type": "string",
                    "enum": [
                      "pending",
                      "verified"
                    ]
                  },
                  "duration": {
                    "type": "string",
                    "enum": [
                      "pending",
                      "verified"
                    ]
                  },
                  "requirements": {
                    "type": "string",
                    "enum": [
                      "pending",
                      "verified"
                    ]
                  },
                  "outputQuantity": {
                    "type": "string",
                    "enum": [
                      "pending",
                      "verified"
                    ]
                  }
                },
                "required": [
                  "ingredients",
                  "duration",
                  "requirements",
                  "outputQuantity"
                ],
                "additionalProperties": false
              },
              "evidence": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
